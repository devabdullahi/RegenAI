# Copy to .env.local and fill in values from your Supabase project settings.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base URL — the /api/v1 suffix is required.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Local development only: set to true to skip Supabase auth checks (server-side flag).
# Blocked in production — the app throws if this is enabled with NODE_ENV=production.
# DEV_AUTH_BYPASS=false
